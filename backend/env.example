# Application Configuration
APP_NAME=Sales Manager API
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development
API_PREFIX=/api/v1

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=sales_user
DB_PASSWORD=sales_password
DB_NAME=sales_manager
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Security Configuration
SECRET_KEY=your-super-secret-key-for-development-only-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
OTP_EXPIRE_MINUTES=10

# SMS Configuration
SMS_PROVIDER=inhouse
SMS_API_KEY=your-sms-api-key
SMS_API_SECRET=your-sms-api-secret
SMS_SENDER_ID=SALES
IS_DEVELOPMENT=true

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Data Layer Configuration (Private Middleware)
DATA_LAYER_URL=http://localhost:8001
DATA_LAYER_CERT_PATH=/path/to/cert.pem
DATA_LAYER_KEY_PATH=/path/to/key.pem

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_FILE_UPLOADS=true
ENABLE_SYNC=true

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# CORS
CORS_ORIGINS=["*"]
